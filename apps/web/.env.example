# Public browser configuration for Supabase Auth.
# Copy to .env.local; enable only when the classroom backend is configured.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_ENABLE_CLOUD_AUTH=false

# Never place a database password, connection string, or secret key in VITE_*.

# Same-origin Node server / Worker Auth relay
VITE_USE_AUTH_PROXY=false
VITE_EXHIBITION_MODE=false
