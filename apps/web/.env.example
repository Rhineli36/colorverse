# Public browser configuration for the upcoming Supabase Auth integration.
# Copy to .env.local. The current UI does not yet consume these values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_ENABLE_CLOUD_AUTH=false

# Never place a database password, connection string, or secret key in VITE_*.
