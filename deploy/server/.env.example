DOMAIN=class.example.com
PUBLIC_ORIGIN=https://class.example.com
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Use the restricted reader/writer accounts. Use an IPv4 session pooler if required.
# Percent-encode passwords. No sslmode query: the server enforces certificate validation.
DATABASE_READER_URL=postgresql://colorverse_identity_reader.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
DATABASE_WRITER_URL=postgresql://colorverse_classroom_writer.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
