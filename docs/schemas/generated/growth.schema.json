{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "planetId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "archive"
            },
            "archiveEntryId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 8,
              "maxLength": 160
            }
          },
          "required": [
            "kind",
            "archiveEntryId",
            "idempotencyKey"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mock"
            },
            "mockSubmissionId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "archiveEntryId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 8,
              "maxLength": 160
            }
          },
          "required": [
            "kind",
            "mockSubmissionId",
            "archiveEntryId",
            "idempotencyKey"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "submission"
            },
            "submissionVersionId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 8,
              "maxLength": 160
            }
          },
          "required": [
            "kind",
            "submissionVersionId",
            "idempotencyKey"
          ],
          "additionalProperties": false
        }
      ]
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "reverted"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "elements": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "layerId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "sceneKind": {
            "type": "string",
            "enum": [
              "exterior",
              "interior"
            ]
          },
          "presetId": {
            "type": "string",
            "enum": [
              "glow-flower",
              "crystal",
              "luminous-leaf",
              "moon-mushroom",
              "cloudlet",
              "floating-island",
              "star-seed",
              "orbit-stone",
              "aurora-jelly",
              "moon-bloom",
              "coral-fan",
              "comet",
              "butterfly",
              "ice-spire",
              "sun-disc",
              "rain-drop",
              "satellite",
              "nebula-shell",
              "little-tree",
              "lotus",
              "meteor-cluster",
              "light-lantern",
              "rainbow-arch",
              "cosmic-eye",
              "snow-flake",
              "feather",
              "bubble-cluster",
              "mountain",
              "spiral-galaxy",
              "portal"
            ]
          },
          "presetVersion": {
            "type": "string",
            "const": "1.0.0"
          },
          "params": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "scale": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 2
              },
              "rotationDeg": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "color": {
                "type": "string",
                "pattern": "^#[\\da-f]{6}$"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "glowIntensity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "motionSpeed": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "particleStyle": {
                "type": "string",
                "enum": [
                  "stardust",
                  "fireflies"
                ]
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            },
            "required": [
              "x",
              "y",
              "scale",
              "rotationDeg",
              "color",
              "opacity",
              "glowIntensity",
              "motionSpeed",
              "seed"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "layerId",
          "sceneKind",
          "presetId",
          "presetVersion",
          "params"
        ],
        "additionalProperties": false
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "acceptedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "appliedRevision": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "revertedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revertedRevision": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "mock",
            "model",
            "rules"
          ]
        },
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "kind",
        "adapter",
        "model",
        "promptVersion"
      ],
      "additionalProperties": false
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "sourceProposalHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "planetId",
    "trigger",
    "baseRevision",
    "status",
    "summary",
    "elements",
    "createdAt",
    "acceptedAt",
    "appliedRevision",
    "revertedAt",
    "revertedRevision",
    "provider",
    "policyVersion"
  ],
  "additionalProperties": false
}
