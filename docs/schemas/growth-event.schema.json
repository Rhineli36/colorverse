{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colorverse.example/schemas/growth-event/1.0.0",
  "title": "COLORVERSE GrowthEvent v1 design draft",
  "description": "Trusted application envelope. References, permissions, revision ordering, preset availability and idempotency require service validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "planetId", "trigger", "baseRevision", "status", "summary", "elements", "createdAt", "acceptedAt", "appliedRevision", "revertedAt", "revertedRevision", "provider", "policyVersion"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "eventId": {"$ref": "#/$defs/uuid"},
    "planetId": {"$ref": "#/$defs/uuid"},
    "trigger": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "mockSubmissionId", "archiveEntryId", "idempotencyKey"],
          "properties": {
            "kind": {"const": "mock"},
            "mockSubmissionId": {"$ref": "#/$defs/uuid"},
            "archiveEntryId": {"$ref": "#/$defs/uuid"},
            "idempotencyKey": {"$ref": "#/$defs/key"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "submissionVersionId", "idempotencyKey"],
          "properties": {
            "kind": {"const": "submission"},
            "submissionVersionId": {"$ref": "#/$defs/uuid"},
            "idempotencyKey": {"$ref": "#/$defs/key"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "archiveEntryId", "idempotencyKey"],
          "properties": {
            "kind": {"const": "archive"},
            "archiveEntryId": {"$ref": "#/$defs/uuid"},
            "idempotencyKey": {"$ref": "#/$defs/key"}
          }
        }
      ]
    },
    "baseRevision": {"type": "integer", "minimum": 0},
    "status": {"enum": ["proposed", "accepted", "rejected", "reverted"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 600},
    "elements": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/element"}},
    "createdAt": {"type": "string", "format": "date-time"},
    "acceptedAt": {"type": ["string", "null"], "format": "date-time"},
    "appliedRevision": {"type": ["integer", "null"], "minimum": 1},
    "revertedAt": {"type": ["string", "null"], "format": "date-time"},
    "revertedRevision": {"type": ["integer", "null"], "minimum": 1},
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "adapter", "model", "promptVersion"],
      "properties": {
        "kind": {"enum": ["mock", "model", "rules"]},
        "adapter": {"type": "string", "minLength": 1, "maxLength": 80},
        "model": {"type": "string", "minLength": 1, "maxLength": 120},
        "promptVersion": {"type": "string", "minLength": 1, "maxLength": 40}
      }
    },
    "policyVersion": {"type": "string", "minLength": 1, "maxLength": 40},
    "sourceProposalHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["proposed", "rejected"]}}},
      "then": {"properties": {"acceptedAt": {"type": "null"}, "appliedRevision": {"type": "null"}, "revertedAt": {"type": "null"}, "revertedRevision": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "accepted"}}},
      "then": {"properties": {"acceptedAt": {"type": "string", "format": "date-time"}, "appliedRevision": {"type": "integer", "minimum": 1}, "revertedAt": {"type": "null"}, "revertedRevision": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "reverted"}}},
      "then": {"properties": {"acceptedAt": {"type": "string", "format": "date-time"}, "appliedRevision": {"type": "integer", "minimum": 1}, "revertedAt": {"type": "string", "format": "date-time"}, "revertedRevision": {"type": "integer", "minimum": 1}}}
    }
  ],
  "$defs": {
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "key": {"type": "string", "minLength": 8, "maxLength": 160},
    "element": {
      "type": "object", "additionalProperties": false,
      "required": ["layerId", "sceneKind", "presetId", "presetVersion", "params"],
      "properties": {
        "layerId": {"$ref": "#/$defs/uuid"},
        "sceneKind": {"enum": ["exterior", "interior"]},
        "presetId": {"enum": ["glow-flower", "crystal", "luminous-leaf", "moon-mushroom", "cloudlet", "floating-island", "star-seed", "orbit-stone", "aurora-jelly", "moon-bloom", "coral-fan", "comet", "butterfly", "ice-spire", "sun-disc", "rain-drop", "satellite", "nebula-shell", "little-tree", "lotus", "meteor-cluster", "light-lantern", "rainbow-arch", "cosmic-eye", "snow-flake", "feather", "bubble-cluster", "mountain", "spiral-galaxy", "portal", "paper-crane", "wind-chime", "solar-sail", "dream-kite", "color-fan", "glass-lantern"]},
        "presetVersion": {"const": "1.0.0"},
        "params": {
          "type": "object", "additionalProperties": false,
          "required": ["x", "y", "scale", "rotationDeg", "color", "opacity", "glowIntensity", "motionSpeed", "seed"],
          "properties": {
            "x": {"type": "number", "minimum": 0, "maximum": 1},
            "y": {"type": "number", "minimum": 0, "maximum": 1},
            "scale": {"type": "number", "minimum": 0.1, "maximum": 2},
            "rotationDeg": {"type": "number", "minimum": -180, "maximum": 180},
            "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
            "opacity": {"type": "number", "minimum": 0, "maximum": 1},
            "glowIntensity": {"type": "number", "minimum": 0, "maximum": 1},
            "motionSpeed": {"type": "number", "minimum": 0, "maximum": 2},
            "particleStyle": {"enum": ["stardust", "fireflies"]},
            "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}
          }
        }
      }
    }
  }
}
