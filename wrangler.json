{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "colorverse-dev",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
